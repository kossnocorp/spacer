{
  "name": "@spcr/model",
  "version": "0.1.0",
  "files": [
    "lib"
  ],
  "type": "module",
  "exports": {
    ".": "./src/predict.ts",
    "./tree": "./src/tree-predict.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./lib/predict.js",
      "./tree": "./lib/tree-predict.js"
    },
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/build-package.mjs",
    "corpus": "node src/corpus.ts",
    "encode": "node src/encode.ts",
    "train": "node src/train.ts",
    "evaluate": "node src/evaluate.ts",
    "format": "node src/format.ts",
    "check": "tsc --noEmit",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "@spcr/playground": "workspace:*",
    "@spcr/tree-sitter": "workspace:*",
    "@tensorflow/tfjs-node": "4.22.0",
    "gpt-tokenizer": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
