{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "pages/**/*.tsx",
    "pages/**/*.ts",
    "routes/**/*.ts",
    "server/**/*.ts",
    "*.config.ts"
  ]
}
